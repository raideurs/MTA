# Jira Personal Access Token (Jira@Bpifrance > Profil > Personal Access Tokens)
# Ne jamais committer le fichier .env reel — uniquement .env.example est versionne.
JIRA_TOKEN=

# Base URL de l'instance Jira
JIRA_BASE_URL=https://jira.web.bpifrance.fr

# Port d'ecoute du proxy local
PORT=4002

# Origine autorisee (l'app Angular en dev)
ALLOWED_ORIGIN=http://localhost:4200
